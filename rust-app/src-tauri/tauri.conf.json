{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uz-Meter",
  "version": "1.0.0",
  "identifier": "uz.meter.configurator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Uz-Meter",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 660,
        "center": true,
        "backgroundColor": "#0a1020",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
